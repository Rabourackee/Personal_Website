{#
  Project cards and the filterable index (homepage, Projects page, tag pages).
  Styles: "index" in site.css. Behaviour (field filter, grid / list view):
  src/assets/js/site.js. Without JavaScript every card shows, as a grid.
#}

{# One project. n: its number in the index. #}
{% macro card(p, n) %}
<li class="card" data-fields="{{ p.data.topics | fields | join(' ') }}">
  <a class="card-link" href="{{ p.url }}">
    <span class="card-media">
      {%- if p.data.cover.endsWith(".mp4") %}
      <video src="{{ p.data.cover }}" muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video>
      {%- else %}
      <img src="{{ p.data.cover }}" width="900" height="600" alt="" loading="lazy" decoding="async">
      {%- endif %}
    </span>
    <span class="card-n">{{ n | pad }}</span>
    <span class="card-title">{{ p.data.title }}</span>
    <span class="card-topics">{{ p.data.topics | join(", ") }}</span>
    <span class="card-year">{{ p.data.year }}</span>
  </a>
</li>
{% endmacro %}

{# A list of cards, numbered by their place in the whole index. #}
{% macro cards(projects, all) %}
<ol class="cards">
  {%- for p in projects %}
  {{ card(p, all | projectNumber(p.url)) }}
  {%- endfor %}
</ol>
{% endmacro %}

{# One labelled group of cards: the label sits in the left column, as in a catalogue. #}
{% macro group(label, projects, all) %}
<section class="px-group" aria-label="{{ label }}">
  <h3 class="px-h"><span>{{ label }}</span> <span class="px-count">{{ projects.length }}</span></h3>
  {{ cards(projects, all) }}
</section>
{% endmacro %}

{# The index: field filter and view switch, then one group per section. #}
{% macro projectIndex(all, disciplines) %}
<div class="px" data-index data-view="grid">
  <div class="px-bar">
    <div class="px-keys" role="group" aria-label="Show projects in">
      <span class="px-tag">filter</span>
      <button type="button" class="tb" data-field="all" aria-pressed="true">all<sup>{{ all.length }}</sup></button>
      {%- for d in disciplines %}
      <button type="button" class="tb" data-field="{{ d.key }}" aria-pressed="false">{{ d.label }}<sup>{{ (all | inField(d.key)).length }}</sup></button>
      {%- endfor %}
    </div>
    <div class="px-view" role="group" aria-label="View as">
      <span class="px-tag">view as</span>
      <button type="button" class="tb" data-view="grid" aria-pressed="true">grid</button>
      <button type="button" class="tb" data-view="list" aria-pressed="false">list</button>
    </div>
  </div>
  {{ group("research & professional works", all | inSection("research"), all) }}
  {{ group("out of interest & hobbies", all | inSection("interests"), all) }}
  <p class="px-status" aria-live="polite"></p>
</div>
{% endmacro %}
