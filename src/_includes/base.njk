<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ cover if cover and not cover.endsWith('.mp4') else '/og-image.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <script>
    // Same sizing model as Cargo: the root font size follows the viewport's
    // short side (so everything in rem scales with the window), and portrait
    // screens get the mobile layout via html.mobile.
    (function () {
      var root = document.documentElement;
      function size() {
        var w = root.clientWidth, h = window.innerHeight;
        var portrait = h > w;
        var mobile = portrait || (matchMedia("(pointer: coarse)").matches && Math.min(w, h) < 600);
        var stretch = portrait ? Math.min((h / w - 1) / 0.7777778, 1) : 0;
        var weight = mobile && !portrait ? 18 : 9 + 5 * stretch;
        root.style.setProperty("--base-size", Math.max(Math.min(w, h) * weight / 100, 20) * 0.16 + "px");
        root.classList.toggle("mobile", mobile);
      }
      size();
      addEventListener("resize", size);
    })();
  </script>
  <link rel="stylesheet" href="/assets/fonts/geist/wght.css">
  <link rel="stylesheet" href="/assets/fonts/geist/wght-italic.css">
  <link rel="stylesheet" href="/assets/fonts/geist-mono/wght.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- for href in styles %}
  <link rel="stylesheet" href="{{ href }}">
  {%- endfor %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <header class="page site-header">
    <div class="page-layout"><div class="page-content bodycopy">
      <nav class="column-set no-stack" style="--columns: 5; --gutter: 2rem">
        <div class="column-unit"><a href="/">YUHAN WANG</a></div>
        <div class="column-unit"></div>
        {%- for item in site.nav %}
        <div class="column-unit" style="text-align: right"><a href="{{ item.href }}"{% if page.url == item.href %} class="active"{% endif %}>{{ item.label }}</a></div>
        {%- endfor %}
      </nav>
      <hr><br>
    </div></div>
  </header>

  {%- if fullBleed %}
  {#- Custom-designed pages (e.g. Roulettective) lay out their own sections edge to edge. #}
  <main class="full-bleed">
{{ content | safe }}
  </main>
  {%- else %}
  <main class="page">
    <div class="page-layout"><div class="page-content bodycopy">
{{ content | safe }}
    </div></div>
  </main>
  {%- endif %}

  <footer class="page site-footer">
    <div class="page-layout"><div class="page-content bodycopy">
      <hr>
      <div class="column-set" style="--columns: 12; --gutter: 3rem">
        <div class="column-unit" style="--span: 5"><b><i>Contact</i></b><br><br>
          <span class="caption">
            Email: {{ site.contact.email }}<br>
            Linkedin: <a href="{{ site.contact.linkedin }}" target="_blank">{{ site.contact.linkedin }}</a><br>
            Instagram: {{ site.contact.instagram }}<br>
            TEL: {{ site.contact.phone }}
          </span>
        </div>
      </div>
    </div></div>
  </footer>
  {%- for src in scripts %}
  <script src="{{ src }}" defer></script>
  {%- endfor %}
</body>
</html>
