<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#f5f5f5">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ cover if cover and not cover.endsWith('.mp4') else '/og-image.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <script>
    // Same sizing model as Cargo: the root font size follows the viewport's
    // short side (so everything in rem scales with the window), and portrait
    // screens get the mobile layout via html.mobile. The shared frame (header,
    // footer, index) is sized in px instead, so it looks the same everywhere.
    (function () {
      var root = document.documentElement;
      function size() {
        var w = root.clientWidth, h = window.innerHeight;
        var portrait = h > w;
        var mobile = portrait || (matchMedia("(pointer: coarse)").matches && Math.min(w, h) < 600);
        var stretch = portrait ? Math.min((h / w - 1) / 0.7777778, 1) : 0;
        var weight = mobile && !portrait ? 18 : 9 + 5 * stretch;
        root.style.setProperty("--base-size", Math.max(Math.min(w, h) * weight / 100, 20) * 0.16 + "px");
        root.classList.toggle("mobile", mobile);
      }
      size();
      addEventListener("resize", size);
    })();
  </script>
  <link rel="stylesheet" href="/assets/fonts/geist/wght.css">
  <link rel="stylesheet" href="/assets/fonts/geist/wght-italic.css">
  <link rel="stylesheet" href="/assets/fonts/geist-mono/wght.css">
  <link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
  {%- for href in styles %}
  <link rel="stylesheet" href="{{ href }}?v={{ build.version }}">
  {%- endfor %}
</head>
{#- isProject: any page in src/projects/. Custom-designed project pages (fullBleed)
    get the overlay header, which floats over their first section. #}
{%- set isProject = "/projects/" in page.inputPath %}
{%- set inProjects = isProject or page.url.startsWith("/tag/") %}
<body{% if bodyClass or (fullBleed and isProject) %} class="{{ bodyClass }}{% if fullBleed and isProject %} is-overlay{% endif %}"{% endif %}>
  <a class="skip" href="#main">skip to content</a>
  {#- The homepage shows the mark at the header's right end; it links to About. #}
  <header class="site-header{% if page.url == "/" %} has-logo{% endif %}" id="top">
    <a class="sh-mark" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>yuhan <br>wang</a>
    <nav class="sh-nav" aria-label="Main">
      {%- for item in site.nav %}
      <a class="sh-word" href="{{ item.href }}"{% if page.url == item.href or (item.href == "/project-categories/" and inProjects) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
    {%- if page.url == "/" %}
    <a class="sh-logo" href="/about/" aria-label="About Yuhan Wang">{% include "mark.svg" %}</a>
    {%- endif %}
  </header>

  {%- if fullBleed %}
  {#- Custom-designed pages (e.g. Roulettective) lay out their own sections edge to edge. #}
  <main id="main" class="full-bleed">
{{ content | safe }}
  </main>
  {%- else %}
  <main id="main" class="page">
    <div class="page-layout"><div class="page-content bodycopy">
      {%- if isProject %}
      {%- set n = collections.projects | projectNumber(page.url) %}
      <header class="ph">
        <p class="ph-crumb"><a class="crumb" href="/project-categories/">projects</a><span aria-hidden="true">/</span><span>{{ n | pad }}</span></p>
        <h1 class="ph-title">{{ title }}</h1>
        <div class="ph-meta">
          <span class="ph-year">{{ year }}</span>
          <ul class="chips" aria-label="Topics">
            {%- for t in topics %}<li><a class="chip" href="/tag/{{ t | topicSlug }}/">{{ t }}</a></li>{% endfor -%}
          </ul>
        </div>
      </header>
      {%- endif %}
{{ content | safe }}
    </div></div>
  </main>
  {%- endif %}

  {%- if isProject %}
  {%- set prev = collections.projects | getPreviousCollectionItem(page) or collections.projects | last %}
  {%- set next = collections.projects | getNextCollectionItem(page) or collections.projects | first %}
  <nav class="pn" aria-label="More projects">
    <a class="pn-link pn-prev" href="{{ prev.url }}">
      <span class="lbl"><span aria-hidden="true">←</span> previous</span>
      <span class="pn-title">{{ prev.data.title }}</span>
    </a>
    <a class="pn-all" href="/project-categories/"><span class="lbl">index</span><span class="pn-title">all projects</span></a>
    <a class="pn-link pn-next" href="{{ next.url }}">
      <span class="lbl">next <span aria-hidden="true">→</span></span>
      <span class="pn-title">{{ next.data.title }}</span>
    </a>
  </nav>
  {%- endif %}

  <footer class="site-footer" id="contact">
    <div class="sf-in">
      <p class="lbl">contact</p>
      <a class="sf-mail" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      <div class="sf-grid">
        <div>
          <p class="lbl">index</p>
          <ul>
            <li><a href="/">home</a></li>
            {%- for item in site.nav %}
            <li><a href="{{ item.href }}">{{ item.label }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        <div>
          <p class="lbl">elsewhere</p>
          <ul>
            <li><a href="{{ site.contact.linkedin }}" target="_blank" rel="noopener">linkedin <span aria-hidden="true">↗</span></a></li>
            <li><a href="{{ site.contact.instagramUrl }}" target="_blank" rel="noopener">instagram {{ site.contact.instagram }} <span aria-hidden="true">↗</span></a></li>
          </ul>
        </div>
        <div>
          <p class="lbl">tel</p>
          <ul><li><a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a></li></ul>
        </div>
        <div class="sf-up">
          <a class="go" href="#top">back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
      <div class="sf-base">
        <span>© {{ build.year }} yuhan wang</span>
        <span>harvard gsd · mit media lab</span>
      </div>
    </div>
  </footer>
  <script src="/assets/js/site.js?v={{ build.version }}" defer></script>
  {%- for src in scripts %}
  <script src="{{ src }}?v={{ build.version }}" defer></script>
  {%- endfor %}
</body>
</html>
