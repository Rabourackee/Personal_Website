---
layout: base.njk
permalink: /
bodyClass: home
fullBleed: true
styles: ["/assets/css/home.css"]
scripts: ["/assets/js/home.js"]
---
{#-
  Homepage. Styles: src/assets/css/home.css (selected works, statement) and
  site.css (the index). The selected-works stage: src/assets/js/home.js.
  Without JavaScript the stage shows the first project and the dashes are inert.
#}
{%- from "cards.njk" import projectIndex %}
{%- set all = collections.projects %}
{%- set featured = collections.featured %}
<h1 class="sr-only">Yuhan Wang</h1>

<!-- ============================================================ selected works -->
{%- if featured.length %}
<section class="hv" id="selected" aria-roledescription="carousel" aria-label="Selected works">
  <div class="hv-stage">
    {%- for p in featured %}
    <figure class="hv-slide{% if loop.first %} is-on{% endif %}" data-i="{{ loop.index0 }}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ featured.length }}: {{ p.data.title }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
      <img src="{{ p.data.hero or p.data.cover }}" alt=""{% if loop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
    </figure>
    {%- endfor %}
    <button type="button" class="hv-half hv-half--prev" aria-label="Previous project" hidden></button>
    <button type="button" class="hv-half hv-half--next" aria-label="Next project" hidden></button>
    <span class="hv-cursor" aria-hidden="true"><span>next</span></span>
  </div>
  <div class="hv-bar">
    <div class="hv-meta">
      <p class="lbl">selected works</p>
      <p class="hv-count" aria-hidden="true"><span class="hv-i">01</span><span class="hv-of"> / {{ featured.length | pad }}</span></p>
      <div class="hv-dash" role="group" aria-label="Choose a project" hidden>
        {%- for p in featured %}
        <button type="button" aria-label="Show {{ p.data.title }}"{% if loop.first %} aria-current="true"{% endif %}><i></i></button>
        {%- endfor %}
      </div>
    </div>
    <div class="hv-caps">
      {%- for p in featured %}
      <div class="hv-cap{% if loop.first %} is-on{% endif %}" data-i="{{ loop.index0 }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
        <h2 class="hv-title"><a href="{{ p.url }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ p.data.title }}</a></h2>
        {%- if p.data.summary %}<p class="hv-sum">{{ p.data.summary }}</p>{% endif %}
        <div class="hv-side">
          {%- if p.data.highlight %}<p class="lbl">{{ p.data.highlight }}</p>{% endif %}
          <a class="go go--accent" href="{{ p.url }}"{% if not loop.first %} tabindex="-1"{% endif %}>view project <span aria-hidden="true">→</span></a>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<!-- ============================================================ statement -->
<section class="hi" aria-label="In brief">
  <p class="lbl hi-tag">yuhan wang</p>
  <p class="hi-statement">I’m a designer, maker and creative technologist producing works on
    <a href="/project-categories/?field=architecture" data-field="architecture">architecture</a>,
    <a href="/project-categories/?field=xr" data-field="xr">XR</a>,
    <a href="/project-categories/?field=physical" data-field="physical">physical interaction</a> and
    <a href="/project-categories/?field=ai" data-field="ai">AI</a>.</p>
</section>

<!-- ============================================================ index -->
<section class="hx" id="index" aria-labelledby="hx-h">
  <header class="sec-head">
    <h2 id="hx-h">index</h2>
    <p class="lbl sec-aside">{{ all.length }} projects · {{ all | yearSpan }}</p>
  </header>
  {{ projectIndex(all, disciplines) }}
</section>
